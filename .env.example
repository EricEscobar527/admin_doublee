#Variables para construccion de Contenedor
NOMBREAPP=admin-doublee-dev
IMAGEN=admin-doublee-dev:1.0.0
MEMORY=512M
PUERTO=8010
RESTART=always
WORKERS=3
# Réplicas de Django detrás de nginx
REPLICAS=2
VOLUMEN=/home/admin-doublee
# En desarrollo recarga el código al guardar; en prod dejar vacío.
GUNICORN_EXTRA=--reload

#Entorno: dev | prod
ENTORNO=dev
SECRET_KEY=cambia-esto
ALLOWED_HOSTS=localhost,127.0.0.1
# Ej. https://admin.midominio.com (requerido en prod para formularios)
CSRF_TRUSTED_ORIGINS=

#Base de datos MySQL (DB_ENGINE=sqlite solo para pruebas locales)
# host.docker.internal = MySQL de tu máquina (MAMP); en prod la IP del servidor
DB_ENGINE=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=admin_doublee
DB_USER="root"
DB_PASSWORD="root"

#WebSockets (avisos en vivo entre réplicas)
REDIS_URL=redis://admin_doublee_redis:6379/0

#JWT del panel
JWT_ACCESS_MINUTES=15
JWT_REFRESH_HOURS=12

#API de soporte (los tokens de cada app se administran en el panel > Aplicaciones)
SUPPORT_RATE_LIMIT_IP_PER_HOUR=10
SUPPORT_RATE_LIMIT_EMAIL_PER_HOUR=5
# nginx (docker-compose) manda la IP real del cliente en X-Forwarded-For
TRUST_X_FORWARDED_FOR=True

#Google Play: llave JSON de la cuenta de servicio (carpeta secrets/, fuera de git)
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/home/admin-doublee/secrets/google-play.json

#Correo que aparece en la política de privacidad
PRIVACY_CONTACT_EMAIL=

#Almacenamiento S3 (si se deja vacío, las imágenes se guardan en ./media)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
# Solo para S3 compatibles (DigitalOcean Spaces, MinIO...)
AWS_S3_ENDPOINT_URL=
AWS_LOCATION=admin-doublee
