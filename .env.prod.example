# Copiar en el servidor como .env y llenar los valores marcados con CAMBIAR.
# Generar secretos: python -c "import secrets; print(secrets.token_urlsafe(50))"

#Contenedores
IMAGEN=admin-doublee:1.0.0
MEMORY=768M
REPLICAS=2
WORKERS=2

#Entorno
ENTORNO=prod
SECRET_KEY=CAMBIAR
# Dominio del panel. Mientras no haya dominio: SITE_ADDRESS=:80, ALLOWED_HOSTS=<IP>, SECURE_COOKIES=False
SITE_ADDRESS=admin.midominio.com
ALLOWED_HOSTS=admin.midominio.com
CSRF_TRUSTED_ORIGINS=https://admin.midominio.com
SECURE_COOKIES=True

#Base de datos (contenedor "db" de docker-compose.prod.yml)
DB_ENGINE=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=admin_doublee
DB_USER=admin_doublee
DB_PASSWORD=CAMBIAR
DB_ROOT_PASSWORD=CAMBIAR

#WebSockets
REDIS_URL=redis://redis:6379/0

#JWT del panel
JWT_ACCESS_MINUTES=15
JWT_REFRESH_HOURS=12

#API de soporte
SUPPORT_RATE_LIMIT_IP_PER_HOUR=10
SUPPORT_RATE_LIMIT_EMAIL_PER_HOUR=5
TRUST_X_FORWARDED_FOR=True

#Google Play: llave JSON de la cuenta de servicio. Copiarla al VPS en /opt/admin-doublee/secrets/google-play.json
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/home/admin-doublee/secrets/google-play.json

#Correo que aparece en la política de privacidad (/viajeok/privacidad/)
PRIVACY_CONTACT_EMAIL=CAMBIAR

#Almacenamiento S3 (vacío = volumen "media" del servidor)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_LOCATION=admin-doublee
